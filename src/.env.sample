# =============================================================================
# WRK542 - Prototype Agents with AI Toolkit and MCP
# Copy this file to .env and fill in your values
# Authentication: run `az login` first (uses DefaultAzureCredential)
# =============================================================================

# Azure AI Foundry / OpenAI Settings
# Used by the MCP semantic search server for embeddings
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# Model deployment name (default matches if omitted)
EMBEDDING_MODEL_DEPLOYMENT_NAME=text-embedding-3-small

# Application Insights (optional, for tracing)
APPLICATIONINSIGHTS_CONNECTION_STRING=your-appinsights-connection-string
