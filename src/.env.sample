# =============================================================================
# WRK542 - Prototype Agents with AI Toolkit and MCP
# Copy this file to .env and fill in your values
# =============================================================================

# Azure AI Foundry / OpenAI Settings
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure AI Foundry Project (for AI Toolkit integration)
PROJECT_CONNECTION_STRING=your-project-connection-string

# Application Insights (optional, for tracing)
APPLICATIONINSIGHTS_CONNECTION_STRING=your-appinsights-connection-string
